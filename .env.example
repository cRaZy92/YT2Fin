# Copy to .env for local use, or enter these in Dokploy > (your compose) > Environment.
HOST_PORT=3230
# Dokploy: keep app data in its persistent files folder (survives redeploys)
CONFIG_PATH=../files/config
# Absolute path on the server of the folder your Jellyfin libraries point at
MEDIA_PATH=/srv/media
# Owner of that media folder (run `stat -c '%u %g' /srv/media` on the server)
PUID=1000
PGID=1000
TZ=Europe/Bratislava
# Optional HTTP basic auth. Leave unset when an auth proxy (Pangolin, Authelia, ...) protects the app;
# then make sure the published port itself is not reachable around that proxy (firewall it).
# AUTH_USER=admin
# AUTH_PASSWORD=change-me
